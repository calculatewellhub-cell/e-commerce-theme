						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/fraunces/fraunces-latin-wght-normal.woff2"
							]
						},
						{
							"fontFamily": "Fraunces",
							"fontStyle": "italic",
