			"radius": {
				"sm": "12px",
				"md": "22px",
				"lg": "28px",
				"pill": "999px",
				"button": "999px"
			},
			"dark": {
				"base": "#1a1115",
				"base-2": "#22161c",
				"surface": "#2a1c23",
				"contrast": "#fbeef0",
				"contrast-2": "#c9adb6",
				"line": "#3b2830",
				"accent-3": "#f2a7bf"
			},
			"heading": {
				"weight": "400",
				"transform": "none"
			},
			"button": {
				"transform": "none",
				"letter-spacing": "0.01em"
			},
			"sheen-on-dark": "linear-gradient(120deg, #e8a0b4 0%, #f8d7e0 45%, #f3b8a6 100%)",
			"on-sheen-dark": "#2b1d22",
			"header": {
				"height": "72px"
			},
			"whatsapp": {
				"background": "#25d366",
				"text": "#06301a"
			},
			"transition": {
				"base": "0.25s ease",
				"spring": "0.5s cubic-bezier(0.2, 0.7, 0.2, 1)"
			}
		}
