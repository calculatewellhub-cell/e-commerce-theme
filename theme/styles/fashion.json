				{
					"slug": "primary-soft",
					"name": "Primary soft",
					"gradient": "linear-gradient(135deg, #1d1d1d, #111111)"
				},
				{
					"slug": "fade-to-contrast",
					"name": "Image shade",
					"gradient": "linear-gradient(180deg, rgba(0,0,0,0) 45%, rgba(0,0,0,0.72) 100%)"
				}
			]
		},
		"shadow": {
			"presets": [
				{
					"slug": "soft",
					"name": "Soft",
					"shadow": "0 18px 40px -28px rgba(0, 0, 0, 0.18)"
				},
				{
					"slug": "card",
					"name": "Card",
					"shadow": "0 1px 0 rgba(0,0,0,0.04), 0 18px 40px -28px rgba(0, 0, 0, 0.18)"
				},
				{
					"slug": "deep",
					"name": "Deep",
					"shadow": "0 40px 60px -30px rgba(0, 0, 0, 0.18)"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Heading (Bodoni Moda)",
					"fontFamily": "\"Bodoni Moda\", Georgia, \"Times New Roman\", \"Noto Serif Devanagari\", serif",
					"fontFace": [
						{
							"fontFamily": "Bodoni Moda",
							"fontStyle": "normal",
							"fontWeight": "400 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/bodoni-moda/bodoni-moda-latin-wght-normal.woff2"
							]
						},
						{
							"fontFamily": "Bodoni Moda",
							"fontStyle": "italic",
							"fontWeight": "400 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/bodoni-moda/bodoni-moda-latin-wght-italic.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Manrope)",
					"fontFamily": "\"Manrope\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans Devanagari\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/manrope/manrope-latin-wght-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans Devanagari\", \"Helvetica Neue\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Extra small",
					"size": "0.78rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.05rem",
					"fluid": {
						"min": "1rem",
						"max": "1.05rem"
					}
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2.2rem",
					"fluid": {
						"min": "1.7rem",
						"max": "2.2rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "2X large",
					"size": "3.2rem",
					"fluid": {
						"min": "2.1rem",
						"max": "3.2rem"
					}
				},
				{
					"slug": "huge",
					"name": "Huge",
					"size": "5.2rem",
					"fluid": {
						"min": "2.6rem",
						"max": "5.2rem"
					}
				}
			]
		},
		"custom": {
			"radius": {
				"sm": "2px",
				"md": "4px",
				"lg": "6px",
				"pill": "999px",
				"button": "0px"
			},
			"dark": {
				"base": "#0f0f0f",
				"base-2": "#171717",
				"surface": "#1c1c1c",
				"contrast": "#f5f1ee",
				"contrast-2": "#b3aca8",
				"line": "#2e2e2e",
				"accent-3": "#f0b7a4"
			},
			"heading": {
				"weight": "500",
				"transform": "none"
			},
			"button": {
				"transform": "uppercase",
				"letter-spacing": "0.06em"
			},
			"header": {
				"height": "72px"
			},
			"whatsapp": {
				"background": "#25d366",
				"text": "#06301a"
			},
			"transition": {
				"base": "0.25s ease",
				"spring": "0.5s cubic-bezier(0.2, 0.7, 0.2, 1)"
			}
		}
	},
	"styles": {
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "500",
					"textTransform": "none"
				}
			},
			"button": {
				"border": {
					"radius": "0px"
				},
				"typography": {
					"textTransform": "uppercase",
					"letterSpacing": "0.06em"
				}
			}
		}
	}
