{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Grocery",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#fbfaf4"
				},
				{
					"slug": "base-2",
					"name": "Base alt",
					"color": "#eef3e2"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#ffffff"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#1d2a1a"
				},
				{
					"slug": "contrast-2",
					"name": "Contrast muted",
					"color": "#56624f"
				},
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#1f4d2b"
				},
				{
					"slug": "primary-2",
					"name": "Primary alt",
					"color": "#2a6238"
				},
				{
					"slug": "primary-3",
					"name": "Primary light",
					"color": "#3b7d49"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#f2a93b"
				},
				{
					"slug": "accent-2",
					"name": "Accent light",
					"color": "#fde3b0"
				},
				{
					"slug": "accent-3",
					"name": "Accent text",
					"color": "#9a5b00"
				},
				{
					"slug": "on-primary",
					"name": "On primary",
					"color": "#ffffff"
				},
				{
					"slug": "on-accent",
					"name": "On accent",
					"color": "#1d2a1a"
				},
				{
					"slug": "line",
					"name": "Line",
					"color": "#dfe6d2"
				},
				{
					"slug": "sale",
					"name": "Sale",
					"color": "#c62828"
				},
				{
					"slug": "success",
					"name": "Success",
					"color": "#2e7d32"
				}
			],
			"gradients": [
				{
					"slug": "accent-sheen",
					"name": "Accent sheen",
					"gradient": "linear-gradient(120deg, #f2a93b 0%, #fcd581 50%, #f2a93b 100%)"
				},
				{
					"slug": "primary-radial",
					"name": "Primary glow",
					"gradient": "radial-gradient(120% 90% at 70% 30%, #3b7d49 0%, #1f4d2b 60%, #12301a 100%)"
				},
				{
					"slug": "primary-soft",
					"name": "Primary soft",
					"gradient": "radial-gradient(80% 120% at 80% 20%, #3b7d49, #1f4d2b)"
				},
				{
					"slug": "fade-to-contrast",
					"name": "Image shade",
					"gradient": "linear-gradient(180deg, rgba(0,0,0,0) 45%, rgba(0,0,0,0.72) 100%)"
				}
			]
		},
		"shadow": {
			"presets": [
				{
					"slug": "soft",
					"name": "Soft",
					"shadow": "0 18px 40px -28px rgba(31, 77, 43, 0.2)"
				},
				{
					"slug": "card",
					"name": "Card",
					"shadow": "0 1px 0 rgba(0,0,0,0.04), 0 18px 40px -28px rgba(31, 77, 43, 0.2)"
				},
				{
					"slug": "deep",
					"name": "Deep",
					"shadow": "0 40px 60px -30px rgba(31, 77, 43, 0.2)"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Heading (Outfit)",
					"fontFamily": "\"Outfit\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans Devanagari\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Outfit",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/outfit/outfit-latin-wght-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Nunito Sans)",
					"fontFamily": "\"Nunito Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans Devanagari\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Nunito Sans",
							"fontStyle": "normal",
							"fontWeight": "200 1000",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/nunito-sans/nunito-sans-latin-wght-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans Devanagari\", \"Helvetica Neue\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Extra small",
					"size": "0.78rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.05rem",
					"fluid": {
						"min": "1rem",
						"max": "1.05rem"
					}
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.35rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2.2rem",
					"fluid": {
						"min": "1.53rem",
						"max": "1.98rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "2X large",
					"size": "3.2rem",
					"fluid": {
						"min": "1.89rem",
						"max": "2.88rem"
					}
				},
				{
					"slug": "huge",
					"name": "Huge",
					"size": "5.2rem",
					"fluid": {
						"min": "2.34rem",
						"max": "4.68rem"
					}
				}
			]
		},
		"custom": {
			"radius": {
				"sm": "10px",
				"md": "16px",
				"lg": "22px",
				"pill": "999px",
				"button": "12px"
			},
			"dark": {
				"base": "#10170f",
				"base-2": "#152014",
				"surface": "#1b281a",
				"contrast": "#eef3e2",
				"contrast-2": "#a9b7a0",
				"line": "#2a3a28",
				"accent-3": "#f7c46b"
			},
			"heading": {
				"weight": "600",
				"transform": "none"
			},
			"button": {
				"transform": "none",
				"letter-spacing": "0.01em"
			},
			"header": {
				"height": "72px"
			},
			"whatsapp": {
				"background": "#25d366",
				"text": "#06301a"
			},
			"transition": {
				"base": "0.25s ease",
				"spring": "0.5s cubic-bezier(0.2, 0.7, 0.2, 1)"
			}
		}
	},
	"styles": {
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "600",
					"textTransform": "none"
				}
			},
			"button": {
				"border": {
					"radius": "12px"
				},
				"typography": {
					"textTransform": "none",
					"letterSpacing": "0.01em"
				}
			}
		}
	}
}
