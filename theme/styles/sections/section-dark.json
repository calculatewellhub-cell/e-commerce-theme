{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Dark section",
	"slug": "section-dark",
	"blockTypes": [ "core/group", "core/columns", "core/column", "core/cover" ],
	"styles": {
		"color": { "gradient": "var:preset|gradient|primary-radial", "text": "var:preset|color|on-primary" },
		"elements": {
			"heading": { "color": { "text": "var:preset|color|on-primary" } },
			"link": { "color": { "text": "var:preset|color|accent-2" }, ":hover": { "color": { "text": "var:preset|color|on-primary" } } },
			"button": {
				"color": { "gradient": "var:preset|gradient|accent-sheen", "text": "var:preset|color|on-accent" },
				":hover": { "color": { "gradient": "var:preset|gradient|accent-sheen", "text": "var:preset|color|on-accent" } }
			}
		}
	}
}
