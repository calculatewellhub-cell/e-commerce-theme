{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Primary section",
	"slug": "section-primary",
	"blockTypes": [ "core/group", "core/columns", "core/column" ],
	"styles": {
		"color": { "background": "var:preset|color|primary", "text": "var:preset|color|on-primary" },
		"elements": {
			"heading": { "color": { "text": "var:preset|color|on-primary" } },
			"link": { "color": { "text": "var:preset|color|accent-2" } }
		}
	}
}
