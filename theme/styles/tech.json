{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Electronics",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#f6f8fb"
				},
				{
					"slug": "base-2",
					"name": "Base alt",
					"color": "#eaf0f7"
				},
				{
					"slug": "surface",
					"name": "Surface",
					"color": "#ffffff"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#0f172a"
				},
				{
					"slug": "contrast-2",
					"name": "Contrast muted",
					"color": "#475569"
				},
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#0b1220"
				},
				{
					"slug": "primary-2",
					"name": "Primary alt",
					"color": "#111b2e"
				},
				{
					"slug": "primary-3",
					"name": "Primary light",
					"color": "#1e3a8a"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#2563eb"
				},
				{
					"slug": "accent-2",
					"name": "Accent light",
					"color": "#93c5fd"
				},
				{
					"slug": "accent-3",
					"name": "Accent text",
					"color": "#1d4ed8"
				},
				{
					"slug": "on-primary",
					"name": "On primary",
					"color": "#ffffff"
				},
				{
					"slug": "on-accent",
					"name": "On accent",
					"color": "#ffffff"
				},
				{
					"slug": "line",
					"name": "Line",
					"color": "#dbe3ee"
				},
				{
					"slug": "sale",
					"name": "Sale",
					"color": "#dc2626"
				},
				{
					"slug": "success",
					"name": "Success",
					"color": "#15803d"
				}
			],
			"gradients": [
				{
					"slug": "accent-sheen",
					"name": "Accent sheen",
					"gradient": "linear-gradient(120deg, #1d4ed8 0%, #3b82f6 50%, #06b6d4 100%)"
				},
				{
					"slug": "primary-radial",
					"name": "Primary glow",
					"gradient": "radial-gradient(120% 90% at 70% 30%, #1e3a8a 0%, #0b1220 60%, #050910 100%)"
				},
				{
					"slug": "primary-soft",
					"name": "Primary soft",
					"gradient": "radial-gradient(80% 120% at 80% 20%, #1e3a8a, #0b1220)"
				},
				{
					"slug": "fade-to-contrast",
					"name": "Image shade",
					"gradient": "linear-gradient(180deg, rgba(0,0,0,0) 45%, rgba(0,0,0,0.72) 100%)"
				}
			]
		},
		"shadow": {
			"presets": [
				{
					"slug": "soft",
					"name": "Soft",
					"shadow": "0 18px 40px -28px rgba(15, 23, 42, 0.25)"
				},
				{
					"slug": "card",
					"name": "Card",
					"shadow": "0 1px 0 rgba(0,0,0,0.04), 0 18px 40px -28px rgba(15, 23, 42, 0.25)"
				},
				{
					"slug": "deep",
					"name": "Deep",
					"shadow": "0 40px 60px -30px rgba(15, 23, 42, 0.25)"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Heading (Space Grotesk)",
					"fontFamily": "\"Space Grotesk\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans Devanagari\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Space Grotesk",
							"fontStyle": "normal",
							"fontWeight": "300 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/space-grotesk/space-grotesk-latin-wght-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Body (Inter)",
					"fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans Devanagari\", \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter/inter-latin-wght-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans Devanagari\", \"Helvetica Neue\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Extra small",
					"size": "0.78rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.05rem",
					"fluid": {
						"min": "1rem",
						"max": "1.05rem"
					}
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.35rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2.2rem",
					"fluid": {
						"min": "1.53rem",
						"max": "1.98rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "2X large",
					"size": "3.2rem",
					"fluid": {
						"min": "1.89rem",
						"max": "2.88rem"
					}
				},
				{
					"slug": "huge",
					"name": "Huge",
					"size": "5.2rem",
					"fluid": {
						"min": "2.34rem",
						"max": "4.68rem"
					}
				}
			]
		},
		"custom": {
			"radius": {
				"sm": "8px",
				"md": "12px",
				"lg": "16px",
				"pill": "999px",
				"button": "10px"
			},
			"dark": {
				"base": "#0a0f1a",
				"base-2": "#0f1626",
				"surface": "#141d30",
				"contrast": "#e2e8f0",
				"contrast-2": "#94a3b8",
				"line": "#1f2a40",
				"accent-3": "#60a5fa"
			},
			"heading": {
				"weight": "600",
				"transform": "none"
			},
			"button": {
				"transform": "none",
				"letter-spacing": "0.01em"
			},
			"header": {
				"height": "72px"
			},
			"whatsapp": {
				"background": "#25d366",
				"text": "#06301a"
			},
			"transition": {
				"base": "0.25s ease",
				"spring": "0.5s cubic-bezier(0.2, 0.7, 0.2, 1)"
			}
		}
	},
	"styles": {
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "600",
					"textTransform": "none"
				}
			},
			"button": {
				"border": {
					"radius": "10px"
				},
				"typography": {
					"textTransform": "none",
					"letterSpacing": "0.01em"
				}
			}
		}
	}
}
